# Shared, NON-secret settings -> ConfigMap "headlamp-stack-config" (oauth2-proxy ns).
# Edit + commit; Argo re-renders the Ingresses/Middleware immediately.
# oauth2-proxy reads APP_HOST at pod start, so restart it after changing:
#   kubectl -n oauth2-proxy rollout restart deploy/oauth2-proxy

# Public FQDN users hit (Tailscale MagicDNS name).
APP_HOST=headlamp.tail3aac60.ts.net
# Hostname requested from the Tailscale operator; must be the first label of APP_HOST.
TS_HOSTNAME=headlamp
